# ─────────────────────────────────────────
# fin-agent-pro Backend Configuration
# ─────────────────────────────────────────
# Copy this file to `.env` and fill in your values.

# SEC EDGAR identity (REQUIRED for SEC data access)
# SEC requires a valid contact email per their fair-access policy.
# Format: "Your Name your.email@example.com"
SEC_EDGAR_IDENTITY=Sihao Liang sihaol3@illinois.edu

# CORS allowed origins (production deployment)
# Comma-separated list. Use "*" for development only.
CORS_ALLOW_ORIGINS=http://localhost:3000

# Logging
LOG_LEVEL=info
